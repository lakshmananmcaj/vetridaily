# ElevenLabs API keys for VetriDaily audio automation
# This is the TEMPLATE file. It is committed to git with PLACEHOLDERS only.
# Real keys go into `.env` in the same folder (which IS gitignored).

# Subscription account (used most often)
ELEVEN_API_SUB=paste_subscription_key_here

# Free accounts
ELEVEN_API_FREE_1=paste_free_key_1_here
ELEVEN_API_FREE_2=paste_free_key_2_here
ELEVEN_API_FREE_3=paste_free_key_3_here

# Voice ID
ELEVEN_VOICE_ID=your_voice_id_here

# Voice tuning
ELEVEN_STABILITY=0.5
ELEVEN_SIMILARITY=0.75
ELEVEN_MODEL=eleven_multilingual_v2
